# ─────────────────────────────────────────────────────────────────────────────
# .env.ci — Variables d'environnement pour la CI GitHub Actions
# Ce fichier est commité car il ne contient PAS de secrets réels.
# Les vraies clés API (TAVILY_API_KEY, etc.) sont injectées via GitHub Secrets.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=3000

# ── Auth ──────────────────────────────────────────────────────────────────────
API_USERNAME=admin
API_PASSWORD=changeme
JWT_SECRET=ci-test-secret-key-github-actions
JWT_EXPIRES_IN=1h

# ── LLM — Ollama (stub, pas de modèle chargé en CI) ──────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
CHROMA_URL=http://localhost:8000

# ── Search ────────────────────────────────────────────────────────────────────
# TAVILY_API_KEY injecté via GitHub Secret ${{ secrets.TAVILY_API_KEY }}
TAVILY_API_KEY=
SEARXNG_URL=http://localhost:8080

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS_ENABLED=false

# ── Rate Limiting (élevé pour la CI) ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
