# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# LLM Providers
# Groq (API - gratuit avec limites)
GROQ_API_KEY=your_groq_api_key_here

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# HuggingFace (optionnel)
HUGGINGFACE_API_KEY=your_hf_api_key_here

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma  # Options: chroma, qdrant, faiss
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=rag_documents

# Qdrant Configuration (alternative)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optionnel pour Qdrant cloud
QDRANT_COLLECTION_NAME=rag_documents

# Embeddings Configuration
EMBEDDINGS_PROVIDER=ollama  # Options: ollama, huggingface, openai
EMBEDDINGS_MODEL=nomic-embed-text  # Pour Ollama
# EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2  # Pour HuggingFace

# Search Engines
# Tavily (1000 requêtes/mois gratuit)
TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search (2000 requêtes/mois gratuit)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# SearXNG (auto-hébergé)
SEARXNG_URL=http://localhost:8888

# Recherche par défaut
DEFAULT_SEARCH_PROVIDER=duckduckgo  # Options: tavily, brave, searxng, duckduckgo

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600  # Cache TTL en secondes

# PostgreSQL Configuration (optionnel)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# Database URL (si vous utilisez TypeORM ou Prisma)
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb

# Document Processing
MAX_FILE_SIZE=10485760  # 10MB en bytes
ALLOWED_FILE_TYPES=pdf,txt,md,doc,docx,csv,json
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOCUMENT=1000

# RAG Configuration
TOP_K_RESULTS=5  # Nombre de documents à récupérer
SIMILARITY_THRESHOLD=0.7  # Seuil de similarité (0-1)
ENABLE_RERANKING=false

# LLM Generation Parameters
MAX_TOKENS=2000
TEMPERATURE=0.7
TOP_P=0.9

# Rate Limiting
RATE_LIMIT_TTL=60  # Fenêtre en secondes
RATE_LIMIT_LIMIT=10  # Nombre de requêtes par fenêtre

# JWT Configuration (si authentification)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=7d

# Logging
LOG_LEVEL=debug  # Options: error, warn, info, debug
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log

# Monitoring (optionnel)
ENABLE_METRICS=false
PROMETHEUS_PORT=9091

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:4200
CORS_CREDENTIALS=true

# File Upload
UPLOAD_DESTINATION=./uploads
TEMP_DESTINATION=./temp

# Webhook/Callbacks (optionnel)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_DOCUMENT_UPLOAD=true
ENABLE_STREAMING=true
ENABLE_CACHE=true
ENABLE_CONVERSATION_MEMORY=true

# Development
DEBUG=false
SWAGGER_ENABLED=true  # Documentation API
