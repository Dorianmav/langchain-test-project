# =======================================================================================
# 🤖 Configuration Système RAG LangChain avec NestJS
# =======================================================================================
# IMPORTANT: Copiez ce fichier vers .env et modifiez selon votre environnement
# Ce fichier contient toutes les variables nécessaires pour le fonctionnement complet
# du système RAG (Retrieval-Augmented Generation)

# =======================================================================================
# CONFIGURATION GÉNÉRALE
# =======================================================================================

# Environnement d'exécution
NODE_ENV=development  # Options: development, production, test

# Port du serveur NestJS (utilisé dans Docker et en local)
PORT=3001

# Préfixe pour les routes API (optionnel)
API_PREFIX=api/v1

# =======================================================================================
# 🧠 CONFIGURATION LLM (Large Language Model)
# =======================================================================================
# Le LLM est utilisé pour générer des réponses basées sur le contexte récupéré

# Fournisseur LLM principal
# Options: 'ollama' (local, gratuit) ou 'groq' (cloud, API key requise)
LLM_PROVIDER=ollama

# --- Configuration Ollama (Recommandé pour le développement local) ---
# Modèle exécuté localement via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2  
# Modèles disponibles: llama3.2, llama3.1, llama2, mistral, mixtral, codellama, etc.
# Installer avec: ollama pull llama3.2

# --- Configuration Groq (Alternative cloud) ---
# API cloud rapide, nécessite une clé API gratuite de https://groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile  
# Modèles disponibles: llama-3.1-70b-versatile, mixtral-8x7b-32768, gemma-7b-it

# =======================================================================================
# 🔤 CONFIGURATION EMBEDDINGS (Vectorisation de texte)
# =======================================================================================
# Les embeddings transforment le texte en vecteurs pour la recherche sémantique

# Fournisseur d'embeddings
# Options: 'ollama' (local, recommandé) ou 'huggingface' (modèles Transformers)
EMBEDDINGS_PROVIDER=ollama

# --- Configuration Ollama Embeddings ---
# Utilise les modèles d'embeddings d'Ollama
EMBEDDINGS_OLLAMA_BASE_URL=http://localhost:11434
EMBEDDINGS_OLLAMA_MODEL=nomic-embed-text  
# Modèles disponibles: nomic-embed-text, mxbai-embed-large, all-minilm
# Installer avec: ollama pull nomic-embed-text

# --- Configuration HuggingFace Embeddings (Alternative) ---
# Modèles de Sentence Transformers
EMBEDDINGS_HF_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_HF_API_KEY=  # Optionnel, uniquement si vous utilisez l'API HuggingFace

# =======================================================================================
# 🗄️ CONFIGURATION VECTOR STORE (Base de données vectorielle)
# =======================================================================================
# Le vector store stocke et recherche les embeddings de documents

# Fournisseur de base de données vectorielle
# Options: 'chroma' (recommandé, simple) ou 'qdrant' (avancé, production)
VECTOR_STORE_PROVIDER=chroma

# --- Configuration ChromaDB (Par défaut) ---
# Base de données vectorielle simple et efficace
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=rag_documents

# --- Configuration Qdrant (Alternative pour production) ---
# Base de données vectorielle haute performance
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_documents
QDRANT_API_KEY=  # Optionnel, pour Qdrant Cloud

# =======================================================================================
# 💾 CONFIGURATION REDIS (Cache)
# =======================================================================================
# Redis améliore les performances en cachant les résultats de requêtes

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Laisser vide si pas de mot de passe (développement)
REDIS_DB=0
REDIS_TTL=3600  # Durée de vie du cache en secondes (1 heure par défaut)

# =======================================================================================
# 🔍 CONFIGURATION MOTEURS DE RECHERCHE WEB
# =======================================================================================
# Moteurs de recherche pour enrichir le RAG avec du contenu web

# Moteur de recherche par défaut
DEFAULT_SEARCH_PROVIDER=duckduckgo  # Options: tavily, brave, searxng, duckduckgo

# --- Tavily Search API (1000 requêtes/mois gratuit) ---
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_QUOTA_LIMIT=1000  # Limite mensuelle de requêtes Tavily

# --- Brave Search API (2000 requêtes/mois gratuit) ---
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# --- SearXNG (auto-hébergé) ---
SEARXNG_URL=http://localhost:8888

# Activer la recherche web
ENABLE_WEB_SEARCH=true

# =======================================================================================
# 📄 CONFIGURATION TRAITEMENT DE DOCUMENTS
# =======================================================================================
# Paramètres pour l'upload et le traitement des documents

# Taille maximale des fichiers uploadés (en bytes)
MAX_FILE_SIZE=10485760  # 10MB par défaut

# Types de fichiers acceptés
ALLOWED_FILE_TYPES=pdf,txt,md,doc,docx,csv,json

# Paramètres de chunking (découpage des documents)
CHUNK_SIZE=1000  # Taille des morceaux de texte
CHUNK_OVERLAP=200  # Chevauchement entre les morceaux
MAX_CHUNKS_PER_DOCUMENT=1000  # Limite de chunks par document

# =======================================================================================
# ⚙️ CONFIGURATION RAG
# =======================================================================================
# Paramètres pour la génération de réponses augmentée par récupération

# Nombre de documents à récupérer par requête
TOP_K_RESULTS=5

# Seuil de similarité minimum (0-1)
SIMILARITY_THRESHOLD=0.7

# Activer le reranking des résultats
ENABLE_RERANKING=false

# =======================================================================================
# 🤖 PARAMÈTRES DE GÉNÉRATION LLM
# =======================================================================================
# Contrôle le comportement de génération du modèle de langage

# Nombre maximum de tokens générés
MAX_TOKENS=2000

# Température (créativité) : 0 = déterministe, 1 = créatif
TEMPERATURE=0.7

# Top-p (nucleus sampling)
TOP_P=0.9

# =======================================================================================
# 🔒 SÉCURITÉ ET AUTHENTIFICATION
# =======================================================================================

# --- JWT Configuration ---
# Secret pour signer les tokens JWT (CHANGEZ EN PRODUCTION!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=7d  # Durée de validité des tokens

# --- Swagger/API Documentation Authentication ---
# Authentification basique pour accéder à Swagger UI
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin123  # CHANGEZ EN PRODUCTION!

# --- Rate Limiting ---
# Protection contre les abus d'API
RATE_LIMIT_TTL=60  # Fenêtre en secondes
RATE_LIMIT_LIMIT=10  # Nombre de requêtes par fenêtre

# =======================================================================================
# 📊 LOGGING ET MONITORING
# =======================================================================================

# Niveau de logging
LOG_LEVEL=debug  # Options: error, warn, info, debug, verbose

# Logging dans un fichier
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log

# Metrics Prometheus (optionnel)
ENABLE_METRICS=false
PROMETHEUS_PORT=9091

# =======================================================================================
# 🌐 CORS (Cross-Origin Resource Sharing)
# =======================================================================================

# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# Autoriser les credentials
CORS_CREDENTIALS=true

# =======================================================================================
# 📁 CHEMINS DE FICHIERS
# =======================================================================================

# Répertoires pour les uploads
UPLOAD_DESTINATION=./uploads
TEMP_DESTINATION=./uploads/temp

# =======================================================================================
# 🪝 WEBHOOKS ET CALLBACKS (Optionnel)
# =======================================================================================

WEBHOOK_URL=
WEBHOOK_SECRET=

# =======================================================================================
# 🚀 FEATURE FLAGS
# =======================================================================================
# Activer/désactiver certaines fonctionnalités

ENABLE_WEB_SEARCH=true
ENABLE_DOCUMENT_UPLOAD=true
ENABLE_STREAMING=true
ENABLE_CACHE=true
ENABLE_CONVERSATION_MEMORY=true

# =======================================================================================
# 🛠️ DÉVELOPPEMENT
# =======================================================================================

# Mode debug
DEBUG=false

# Activer Swagger UI
SWAGGER_ENABLED=true

# =======================================================================================
# 🗃️ BASE DE DONNÉES POSTGRES (Optionnel - pour audit/logs)
# =======================================================================================
# Utilisé pour stocker les logs d'audit et l'historique

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# URL de connexion complète
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb

# =======================================================================================
# 📝 NOTES
# =======================================================================================
# 
# 🔹 VARIABLES REQUISES (minimum pour fonctionner):
#    - PORT
#    - LLM_PROVIDER + (OLLAMA_BASE_URL et OLLAMA_MODEL) ou (GROQ_API_KEY et GROQ_MODEL)
#    - EMBEDDINGS_PROVIDER + configuration correspondante
#    - VECTOR_STORE_PROVIDER + configuration correspondante
#    - REDIS_HOST et REDIS_PORT
#
# 🔹 VARIABLES OPTIONNELLES:
#    - Moteurs de recherche web (API keys)
#    - PostgreSQL (pour audit avancé)
#    - Webhooks
#    - Metrics/Monitoring
#
# 🔹 POUR LA PRODUCTION:
#    - Changez JWT_SECRET avec une valeur forte et unique
#    - Changez SWAGGER_USER et SWAGGER_PASSWORD
#    - Utilisez des mots de passe forts pour toutes les bases de données
#    - Désactivez DEBUG et ajustez LOG_LEVEL à 'info' ou 'warn'
#    - Configurez CORS_ORIGIN avec vos domaines réels
#    - Activez ENABLE_METRICS pour le monitoring
#    - Utilisez HTTPS et des certificats SSL valides
#
# 🔹 DOCKER:
#    Les URLs comme localhost doivent être remplacées par les noms de services Docker:
#    - OLLAMA_BASE_URL=http://ollama:11434
#    - CHROMA_URL=http://chromadb:8000
#    - REDIS_HOST=redis
#    - QDRANT_URL=http://qdrant:6333
#
# =======================================================================================
