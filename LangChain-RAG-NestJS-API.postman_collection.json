          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"summarization\",\n  \"maxLength\": 100,\n  \"variables\": {\n    \"text\": \"LangChain est un framework open source qui permet de développer des applications alimentées par des modèles de langage. Il fournit des outils pour gérer les prompts, les chaînes de traitement, et l\u0027intégration avec diverses sources de données.\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/prompts/create",
              "path": [
                "prompts",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Crée un prompt de résumé avec longueur maximale"
          },
          "response": []
        },
        {
          "name": "Create Code Explanation Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
