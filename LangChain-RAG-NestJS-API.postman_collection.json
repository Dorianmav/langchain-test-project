            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"code\",\n  \"variables\": {\n    \"code\": \"const sum = (a, b) =\u003e a + b;\",\n    \"language\": \"JavaScript\"\n  }\n}"
            },
