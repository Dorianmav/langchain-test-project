      "name": "1. Prompts - Création",
      "item": [
        {
          "name": "Create RAG Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"rag\",\n  \"includeFewShot\": false,\n  \"variables\": {\n    \"context\": \"LangChain est un framework pour développer des applications alimentées par des modèles de langage.\",\n    \"question\": \"Qu\u0027est-ce que LangChain ?\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/prompts/create",
              "path": [
                "prompts",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Crée un prompt RAG avec contexte et question"
          },
          "response": []
        },
        {
          "name": "Create Conversation Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"conversation\",\n  \"includeHistory\": true,\n  \"variables\": {\n    \"message\": \"Bonjour, comment ça va ?\",\n    \"history\": \"User: Salut!\\nAssistant: Bonjour!\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/prompts/create",
              "path": [
